# ==============================================================================
# SIMOA — Configuración de Entorno (Plantilla sin secretos reales)
# Copia este archivo como `.env` y define tus propios valores antes de ejecutar.
# ==============================================================================

# Base de datos MySQL / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=simoa

# Seguridad JWT (usa una clave aleatoria de al menos 32 caracteres)
JWT_SECRET_KEY=REEMPLAZA_CON_CLAVE_SECRETA_ALEATORIA_DE_64_CARACTERES
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=8

# Cookies HttpOnly y CORS
# En producción con HTTPS cambia COOKIE_SECURE a true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
FRONTEND_ORIGIN=http://localhost:3005

# Limitador de intentos fallidos de inicio de sesión
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=60

# Broker MQTT (Mosquitto) - RF-06
MQTT_ENABLED=true
MQTT_BROKER_HOST=127.0.0.1
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=simoa-backend-ingest
MQTT_QOS=1
MQTT_KEEPALIVE_SECONDS=60
MQTT_CONNECT_TIMEOUT_SECONDS=10
MQTT_RECONNECT_MIN_DELAY=1
MQTT_RECONNECT_MAX_DELAY=60
MQTT_QUEUE_MAXSIZE=2000
MQTT_CACHE_TTL_SECONDS=15

# Configuración controlada para registrar el primer Administrador (python -m app.seed_admin)
ADMIN_INIT_NAME=Administrador SIMOA
ADMIN_INIT_EMAIL=admin@simoa-ejemplo.org
ADMIN_INIT_PASSWORD=REEMPLAZA_CON_CONTRASENA_SEGURA_MIN_8_CHARS

# Opcional: Gemini AI API Key
GEMINI_API_KEY=MY_GEMINI_API_KEY
